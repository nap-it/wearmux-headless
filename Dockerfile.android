# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git config --global url.https://github.com/.insteadOf ssh://git@github.com/
WORKDIR /app
COPY package.json package-lock.json ./
# Android owns GATT: do not compile Noble/HCI or the optional OpenGL backend.
# Sharp ships an ARM64 prebuilt package and does not need its install script.
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --omit=dev --legacy-peer-deps --no-audit --no-fund

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini fonts-dejavu-core fontconfig \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --chown=node:node . .
ENV NODE_ENV=production DEVICE_TRANSPORT=android-ble ANDROID_BLE_BRIDGE_HOST=0.0.0.0
USER node
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:8765/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "tools/sessions.js"]
