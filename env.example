# BrilliantSole Connector - Docker Configuration
# Copy this file to .env and customize for your setup

# ============================================
# DOCKER BUILD CONFIGURATION
# ============================================
DOCKERFILE=Dockerfile.optimized
VERSION=latest

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
DEBUG=0

# ============================================
# BLUETOOTH DEVICE CONFIGURATION
# ============================================
# Device name (e.g., "Brilliant Frame 12")
DEVICE_NAME=

# Device MAC address (e.g., "CE:59:C3:0F:4D:C9")
# Leave empty for auto-discovery
DEVICE_ID=

# Use custom Noble implementation (recommended for Linux)
USE_CUSTOM_NOBLE=true

# ============================================
# ZENOH CONFIGURATION
# ============================================
# Enable Zenoh data publishing (0=disabled, 1=enabled)
ZENOH_ENABLE=1

# Zenoh log level (trace, debug, info, warn, error)
ZENOH_LOG_LEVEL=info

# ============================================
# SENSOR CONFIGURATION
# ============================================
# Comma-separated list of enabled sensors
# Note: Frame hardware has: acceleration, magnetometer, orientation, tapDetector
# Frame does NOT have: gyroscope, linearAcceleration, gameRotation, rotation
ENABLED_SENSORS=acceleration,magnetometer,orientation,tapDetector

# Sensor update rates (Hz or ms format, e.g., "20" or "50ms")
# ACCEL_RATE=20
# GYRO_RATE=20
# MAG_RATE=20
# ORIENTATION_RATE=20

# ============================================
# DISPLAY CONFIGURATION
# ============================================
# Show timing information for display updates (0=off, 1=on)
DISPLAY_TIMING=0

# ============================================
# ML / GESTURE DETECTION CONFIGURATION
# ============================================
# Minimum confidence threshold for ML gesture detection (0.0-1.0)
ML_CONFIDENCE_THRESHOLD=0.6

# Gesture cooldown period (milliseconds)
GESTURE_COOLDOWN_MS=1000

# ============================================
# DOCKER RUNTIME CONFIGURATION
# ============================================
# Run container in privileged mode (required for BLE on most systems)
PRIVILEGED=true

# ============================================
# DEVELOPMENT SETTINGS (Optional)
# ============================================
# Enable debug gestures logging
# DEBUG_GESTURES=1

# Enable display timing analysis
# DISPLAY_TIMING=1

# Enable verbose debug output
# DEBUG=1


