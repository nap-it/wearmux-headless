{
  "name": "wearmux-headless",
  "version": "0.1.0",
  "description": "Headless Node.js acquisition and distributed-processing host for the WearMux wearable toolchain.",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "aedes": "^0.51.3",
    "auto-bind": "^5.0.1",
    "brilliantsole": "^0.0.73",
    "dgram": "^1.0.1",
    "mqtt": "^5.15.1",
    "opentype.js": "^1.3.4",
    "rgbquant": "^1.1.2",
    "sharp": "^0.34.4",
    "woff2-encoder": "^2.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "scripts": {
    "start": "node tools/launcher.js --config ./config",
    "help": "echo 'Available scripts: start, microphone:rtsp, microphone:record, clean:recordings, sensors, display, camera, examples:car, examples:latency, examples:test'",
    "microphone:rtsp": "node tools/run-with-config.js microphone/index.js",
    "microphone:record": "node tools/run-with-config.js microphone/record-audio.js",
    "sensors": "node tools/run-with-config.js sensors/index.js",
    "sensors:pressure-map": "node tools/run-with-config.js sensors/pressure-map.js",
    "sensors:ml-gesture": "node tools/run-with-config.js sensors/inference/real-time-ml-gesture.js",
    "sensors:tflite": "node tools/run-with-config.js sensors/inference/tflite-runner.js",
    "sensors:remote-inference": "node tools/run-with-config.js sensors/inference/remote-inference.js",
    "sensors:inference": "node tools/run-with-config.js sensors/training/run-inference.js",
    "sensors:collect-training": "node tools/run-with-config.js sensors/training/collect-training-data.js",
    "wifi:setup": "node tools/run-with-config.js tools/wifi-setup.js",
    "mqtt:broker": "node tools/mqtt-broker.js",
    "whisper:setup": "python3 -m venv venv && venv/bin/pip install -r requirements.txt",
    "whisper:runner": "node whisper/launcher.js",
    "whisper:listen": "venv/bin/python3 whisper/listen.py",
    "yolo:setup": "python3 -m venv venv && venv/bin/pip install -r requirements.txt",
    "yolo:runner": "node yolo/launcher.js",
    "yolo:listen": "venv/bin/python3 yolo/listen.py",
    "yolo:view": "venv/bin/python3 yolo/view.py",
    "yolo:test": "venv/bin/python3 yolo/test_publish.py",
    "display": "node tools/run-with-config.js display/index.js",
    "camera": "node tools/run-with-config.js camera/index.js",
    "examples:car-help": "echo 'Car demo (examples/car-interaction):\n  npm run examples:car-demo   # Glasses (demo mode)\n  npm run examples:car        # Car sim\n  npm run examples:test       # Tests'",
    "examples:car-demo": "node examples/car-interaction/glasses-controller.js --demo",
    "examples:car": "cd examples/car-interaction && node car-simulator.js",
    "examples:latency": "node tools/run-with-config.js examples/latency-evaluation/index.js",
    "examples:test": "jest examples",
    "clean:recordings": "node -e \"const p='microphone/recordings',fs=require('fs');if(fs.existsSync(p))fs.readdirSync(p).forEach(f=>fs.rmSync(p+'/'+f,{recursive:true,force:true}))\"",
    "clean:training-data": "node -e \"const p='training-data',fs=require('fs');if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true})\"",
    "test": "jest --runInBand"
  }
}
